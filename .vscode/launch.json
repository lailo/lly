{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "lly: TUI",
      "type": "debugpy",
      "request": "launch",
      "module": "lly",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "lly: scan",
      "type": "debugpy",
      "request": "launch",
      "module": "lly",
      "args": ["scan", "--timeout", "5"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "lly: list",
      "type": "debugpy",
      "request": "launch",
      "module": "lly",
      "args": ["list"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "lly: status",
      "type": "debugpy",
      "request": "launch",
      "module": "lly",
      "args": ["status"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "lly: custom args…",
      "type": "debugpy",
      "request": "launch",
      "module": "lly",
      "args": "${command:pickArgs}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "pytest: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "pickArgs",
      "type": "promptString",
      "description": "Args to pass to `lly` (e.g. `action reboot myid`)",
      "default": ""
    }
  ]
}
